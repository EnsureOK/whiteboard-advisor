# ===== LLM / 检索 =====
# 千帆大模型平台 (LLM + embedding);未配置时全链路降级 mock 模式
QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
# 交互轮(快,体感关键)与复杂规划(deep)分流
QIANFAN_MODEL_FAST=ernie-4.5-turbo-128k
QIANFAN_MODEL_DEEP=deepseek-v4-pro
# 知识库向量化
QIANFAN_EMBEDDING_MODEL=bge-large-zh

# ===== 登录态 =====
# JWT 签名密钥(生产必须设置随机长字符串)
JWT_SECRET=

# ===== 联网搜索(对话信源角标) =====
BOCHA_API_KEY=

# ===== 支付(Stripe Checkout;支付宝/微信由 Stripe 聚合) =====
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== 企业微信 =====
# 群机器人单向推送(每日简报/任务完成)
WECOM_WEBHOOK_URL=
# 自建应用双向回调(@客户名 让助理干活)
WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_APP_TOKEN=
WECOM_APP_AES_KEY=
WECOM_APP_AGENTID=

# ===== 短信验证码(手机号登录;空则前端隐藏短信通道) =====
SMS_PROVIDER=          # 空 | aliyun
SMS_ALIYUN_AK_ID=
SMS_ALIYUN_AK_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ===== 语音 ASR / TTS(可选) =====
BAIDU_SPEECH_API_KEY=
BAIDU_SPEECH_SECRET_KEY=
